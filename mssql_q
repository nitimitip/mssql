
--------------------------Find the most expensive stored procedures

USE YourDatabaseName;
GO

SELECT TOP (20)
    OBJECT_SCHEMA_NAME(
        ps.object_id, ps.database_id
    ) AS SchemaName,

    OBJECT_NAME(
        ps.object_id, ps.database_id
    ) AS ProcedureName,

    ps.execution_count AS ExecutionCount,

    CAST(
        ps.total_elapsed_time / 1000.0 /
        NULLIF(ps.execution_count, 0)
        AS DECIMAL(18,2)
    ) AS AvgDurationMs,

    CAST(
        ps.total_elapsed_time / 1000.0
        AS DECIMAL(18,2)
    ) AS TotalDurationMs,

    CAST(
        ps.total_worker_time / 1000.0 /
        NULLIF(ps.execution_count, 0)
        AS DECIMAL(18,2)
    ) AS AvgCpuMs,

    ps.total_logical_reads /
        NULLIF(ps.execution_count, 0)
        AS AvgLogicalReads,

    ps.last_execution_time AS LastExecuted

FROM sys.dm_exec_procedure_stats ps

WHERE ps.database_id = DB_ID()

ORDER BY ps.total_elapsed_time DESC;







